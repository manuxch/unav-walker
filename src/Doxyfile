PROJECT_NAME           = silo-vib
PROJECT_BRIEF          = "Descarga de un silo 2D de discos sobre una base vibrada"
OUTPUT_DIRECTORY       = doc
OUTPUT_LANGUAGE        = Spanish
INPUT                  = README.md . tests
FILE_PATTERNS          = *.hpp *.cpp *.md
EXCLUDE_PATTERNS       = *.orig *BACKUP*
RECURSIVE              = NO
USE_MDFILE_AS_MAINPAGE = README.md
EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
EXTRACT_ANON_NSPACES   = YES
JAVADOC_AUTOBRIEF      = YES
SOURCE_BROWSER         = YES
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = YES
